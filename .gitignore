# ---------------------------------------------------------------- Release builds
# What the Release workflow makes (also if you run its steps on your own computer).
/out/
/dmg/
JobPortal.AppDir/
appimagetool
pdf-engine/
*.AppImage
*.dmg
*.exe
*.msi
*.msix
*.cab

# ---------------------------------------------------------------- JobPortal data
# JobPortal keeps user data outside the repo (see README, "Your data"). These catch a data folder pointed inside the
# checkout by mistake, and anything from one that got copied in.
/data/
/jobportal-data/
/dev-data/
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.pid
chatgpt_auth.json

# ---------------------------------------------------------------- Secrets
.env
.env.*
!.env.example
*.pem

# ---------------------------------------------------------------- Logs, temporary and backup files
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej
nohup.out

